# /etc/discord-voice-live/announce.env  (root:root, mode 600: it holds the webhook URL)

# Announcements channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME

# Optional: send one event's posts to a different channel with its own webhook.
# The name is the event name in events.json in capitals, plus _WEBHOOK_URL. Blank = WEBHOOK_URL.
FRIDAY_WEBHOOK_URL=

# Optional: only announce these events (comma separated). Blank = every enabled event.
ANNOUNCE_EVENTS=

# People in voice before it posts (an event can override this with "min_voice")
MIN_VOICE=2

# Optional opt-in role to ping on the first post only (Server Settings -> Roles -> Copy Role ID).
PING_ROLE_ID=

# Minutes between head-count edits while live
UPDATE_MIN=5
