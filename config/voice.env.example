# /etc/discord-voice-live/voice.env  (no secrets in this file)

# Discord server ID (Server Settings -> Widget shows it; or right-click the server -> Copy Server ID)
VOICE_GUILD_ID=000000000000000000

# Channel groups: name=channelId[,channelId];name=channelId
# A group's count is the total of its channels. Names: lowercase letters, digits, - or _.
VOICE_GROUPS=friday=000000000000000011;tactical=000000000000000021,000000000000000022

# Gap (seconds) that still counts as the same session
VOICE_GRACE_SECONDS=600
